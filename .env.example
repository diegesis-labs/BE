# 설정값의 뜻과 기본값은 docs/CONFIGURATION.md 에 있다.
# 이 파일을 .env 로 복사한 다음 비어 있는 값을 채운다.

# 서버
APP_ENV=local
PORT=8080
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# 데이터베이스
DATABASE_URL=postgresql+asyncpg://diegesis:diegesis@localhost:5432/diegesis

# 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOGIN_SESSION_TTL_HOURS=336
LOGIN_COOKIE_NAME=diegesis_session

# 선곡
RECOMMENDATION_TOP_K=10
DEFAULT_EMBEDDING_MODEL=muq-mulan

# 음원 저장소
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/audio
STORAGE_LOCAL_BASE_URL=http://localhost:8080/api/dev/audio
STORAGE_LOCAL_SIGNING_KEY=local-dev-only
AUDIO_URL_TTL_SECONDS=3600

# 묶음 적재
BUNDLE_MAX_SIZE_MB=200
